# Postgres connection used by the backend (SQLAlchemy URL).
DATABASE_URL=postgresql+psycopg2://agents:agents@postgres:5432/agents

# OpenAI-compatible endpoint for the model (e.g. an open-weight model via
# a hosted API such as Together/Fireworks/OpenRouter).
MODEL_API_BASE=https://api.example.com/v1
MODEL_API_KEY=changeme
