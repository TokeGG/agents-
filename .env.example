# Postgres connection used by the backend (SQLAlchemy URL).
DATABASE_URL=postgresql+psycopg2://agents:agents@postgres:5432/agents

# OpenAI-compatible endpoint for the model (e.g. an open-weight model via
# a hosted API such as Together/Fireworks/OpenRouter).
MODEL_API_BASE=https://api.example.com/v1
MODEL_API_KEY=changeme

# Stub bearer-token auth for the API and WebSocket stream (backend/app/auth.py).
# Generate a long random value (e.g. `openssl rand -hex 32`) and keep it secret —
# it is the only thing standing between the public internet and this server
# once deployed. The frontend must be built with the same value as
# VITE_AUTH_TOKEN (see frontend/.env.example). This is a stub, not full login
# (passkey/2FA) — see the platform spec §9 for the deploy-time requirement.
AUTH_TOKEN=changeme
